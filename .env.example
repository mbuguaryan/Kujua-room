# ─────────────────────────────────────────────────────────────────────────────
# frontend/.env  — the browser bundle
# ─────────────────────────────────────────────────────────────────────────────
# Only VITE_-prefixed values reach the bundle. That prefix is what keeps the
# service-role key and the Cloudflare token out of the browser: client code
# cannot see anything else. frontend/scripts/check-bundle-secrets.mjs enforces
# it on every build.
#
# VITE_API_BASE_URL points at the deployed Edge Functions in every environment,
# local dev included, so testing and production share one API and one database.
VITE_SUPABASE_URL=https://cjoqupshuruftzgzyksm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EizN2kUIxgHb9gxVV9mh1Q_PQqRQi9X
VITE_API_BASE_URL=https://cjoqupshuruftzgzyksm.supabase.co/functions/v1

# ─────────────────────────────────────────────────────────────────────────────
# Edge Function secrets — set with `supabase secrets set`, NOT in a file
# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically into deployed functions. Do not set them yourself; Supabase
# rejects secrets beginning with SUPABASE_.
#
#   supabase secrets set --workdir backend \
#     MEDIA_ADAPTER=mock \
#     ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain \
#     CLOUDFLARE_ACCOUNT_ID=... \
#     CLOUDFLARE_REALTIMEKIT_APP_ID=... \
#     CLOUDFLARE_API_TOKEN=...
#
# ALLOWED_ORIGINS must list every origin that calls the API — include
# http://localhost:3000 or local dev is refused by CORS. Never "*".
