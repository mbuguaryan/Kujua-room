# Two processes, two env files. Copy each to the sibling name shown below.

# ─────────────────────────────────────────────────────────────────────────────
# frontend/.env      — the browser bundle
# ─────────────────────────────────────────────────────────────────────────────
# Only VITE_-prefixed values reach the bundle. That prefix is what keeps the
# service-role key and the Cloudflare token out of the browser: client code
# cannot see anything else. frontend/scripts/check-bundle-secrets.mjs enforces
# it on every build.
VITE_SUPABASE_URL=https://cjoqupshuruftzgzyksm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EizN2kUIxgHb9gxVV9mh1Q_PQqRQi9X
# Local:    http://127.0.0.1:54321/functions/v1
# Deployed: https://<project-ref>.supabase.co/functions/v1
VITE_API_BASE_URL=http://127.0.0.1:54321/functions/v1

# ─────────────────────────────────────────────────────────────────────────────
# backend/.env.local — Edge Functions. Never VITE_-prefixed, never committed.
# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE_URL and SUPABASE_ANON_KEY are injected by the platform when deployed.
SUPABASE_SERVICE_ROLE_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_REALTIMEKIT_APP_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_RTK_HOST_PRESET=host
CLOUDFLARE_RTK_MODERATOR_PRESET=moderator
CLOUDFLARE_RTK_SPEAKER_PRESET=speaker
CLOUDFLARE_RTK_AUDIENCE_PRESET=audience
MEDIA_ADAPTER=mock

# Comma-separated CORS allowlist. Never "*", never echoed from the request.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
